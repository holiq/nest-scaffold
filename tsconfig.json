{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@services/*": [
        "src/modules/prisma/services/*",
        "src/modules/user/services/*",
        "src/modules/auth/services/*",
        "src/modules/audit-log/services/*",
        "src/modules/role/services/*",
        "src/modules/permission/services/*",
        "src/modules/common/circuit-breaker/services/*",
        "src/modules/common/upload/services/*"
      ],
      "@requests/*": [
        "src/modules/user/controllers/requests/*",
        "src/modules/auth/controllers/requests/*",
        "src/modules/audit-log/controllers/requests/*",
        "src/modules/role/controllers/requests/*",
        "src/modules/permission/controllers/requests/*"
      ],
      "@viewmodels/*": [
        "src/modules/user/controllers/viewmodels/*",
        "src/modules/auth/controllers/viewmodels/*",
        "src/modules/audit-log/controllers/viewmodels/*",
        "src/modules/role/controllers/viewmodels/*",
        "src/modules/permission/controllers/viewmodels/*"
      ],
      "@modules/*": [
        "src/modules/prisma/*",
        "src/modules/user/*",
        "src/modules/auth/*",
        "src/modules/common/circuit-breaker/*",
        "src/modules/common/upload/*",
        "src/modules/audit-log/*",
        "src/modules/role/*",
        "src/modules/permission/*",
        "src/modules/config/queue/*",
        "src/modules/queues/auth/*"
      ],
      "@utils/*": ["src/utils/*"]
    }
  }
}
